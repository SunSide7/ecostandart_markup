                    p.text-hint.color-black Попробуйте изменить запрос
                p.text-caption-bold.color-light-grey.p-16 Популярные запросы
                .d-flex.flex-column.px-60.py-8
                    p.text-body-bold.color-black.clamp-line-2 Производственный контроль для Российской академии наук
                    p.text-hint.color-light-grey.clamp-line-2 Новости
                .d-flex.flex-column.px-60.py-8
