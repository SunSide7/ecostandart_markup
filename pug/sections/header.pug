                    p.text-hint.color-light-grey.clamp-line-2 Охрана труда
                .d-flex.flex-column.px-60.py-8
                    p.text-body-bold.color-black.clamp-line-2 Аутсорсинг
                    p.text-hint.color-light-grey.clamp-line-2 Услуги
            a.btn-primary
                span.text-center Офис на карте
            
