.header-bg-blur.h-100
//.header CAN BE .active
.header
    .d-flex.align-items-center.justify-content-between
        img(src="img/assets/logos/medium/logo_ecostandart_black.svg")
        .d-flex.d-xl-none.gap-4
            a.ghost.big.bg-color-primary-light-green(href="tel: 8800333-82-05")
                img(src="img/assets/icons/small/social_phone_white.svg")
            .menu-header-button.bg-gradient-horizontal-primary

        .position-relative.d-none.d-xl-flex.end-8
            //Меню первого уровня
            .menu-header.horizontal
                a(href="#").active О компании
                a(href="#") Услуги
                a(href="#") Наш опыт
                a(href="#") Клиентам
                a(href="#") Мероприятия
                a(href="#") Медиа
                a(href="#") Контакты

        .position-relative.d-none.d-xl-flex.align-items-center
            .position-absolute.d-flex.align-items-center.end-100
                //.phone-header CAN BE .active (when search opened)
                .phone-header
                    a.phone-header-text(href="tel: 8800333-82-05")
                        p.text-body.color-primary-light-green 8 800 333-82-05
                        p.text-caption.color-grey Бесплатно по РФ
                    .ghost.big.bg-color-primary-light-green
                        img(src="img/assets/icons/small/social_phone_white.svg")
                //.search CAN BE .active
                .search
                    img.search-button(src="img/assets/icons/small/icon_search_grey.svg")
                    input(placeholder="Поиск")
                    img.search-close(src="img/assets/icons/small/icon_exit_grey.svg")
                    .search-result.br-20.bg-color-white
                        .search-value.d-flex.flex-column.px-60.py-16
                            p.text-body-bold.color-black Ничего не нашлось
                            p.text-hint.color-black Попробуйте изменить запрос
                        p.text-caption-bold.color-light-grey.p-16 Популярные запросы
                        .d-flex.flex-column.px-60.py-8
                            p.text-body-bold.color-black.clamp-line-1 Производственный контроль для Российской академии наук
                            p.text-hint.color-light-grey.clamp-line-1 Новости
                        .d-flex.flex-column.px-60.py-8
                            p.text-body-bold.color-black.clamp-line-1 Специальная оценка условий труда: почему она не может быть дешевой
                            p.text-hint.color-light-grey.clamp-line-1 Блог
                        .d-flex.flex-column.px-60.py-8
                            p.text-body-bold.color-black.clamp-line-1 Охрана труда и техника безопасности на предприятии Охрана труда и техника безопасности на предприятии Охрана труда и техника безопасности на предприятии Охрана труда и техника безопасности на предприятии
                            p.text-hint.color-light-grey.clamp-line-1 Охрана труда
                        .d-flex.flex-column.px-60.py-8
                            p.text-body-bold.color-black.clamp-line-1 Аутсорсинг
                            p.text-hint.color-light-grey.clamp-line-1 Услуги
            button.btn-primary.ms-4 <span>Связаться</span>
    .header-menu
        .d-none.d-xl-flex.w-100.overflow-hidden
            .header-menu-slot
                //Меню второго уровня
                .menu-header.vertical.menu-primary
            .header-menu-visir-area
                .menu-sight
                    img.menu-visir-left(src="img/sections/header/menu_visir_left.svg" loading="lazy" alt="")
                    img.menu-visir-axis(src="img/sections/header/menu_visir_axis.svg" loading="lazy" alt="")
                    img.menu-visir-right(src="img/sections/header/menu_visir_right.svg" loading="lazy" alt="")
            .position-relative.header-menu-slot
                //Меню третьего уровня
                .menu-header.vertical.menu-secondary
            .header-menu-info
                .position-relative
                    p.text-caption-bold.color-black Выберите офис:
                    //.dropdown-header CAN BE .active
                    .dropdown-header.header-sities
                        .dropdown-item
                            //Текущее значение
                            span.current-city.text-caption-bold Москва
                        hr
                        //Города для выбора
                        .dropdown-item.hoverable
                            span.text-caption-bold Санкт-Петербург
                        .dropdown-item.hoverable
                            span.text-caption-bold Хабаровск
                        .dropdown-item.hoverable
                            span.text-caption-bold Новосибирск
                        .dropdown-item.hoverable
                            span.text-caption-bold Краснодар
                        .dropdown-item.hoverable
                            span.text-caption-bold Красноярск
                        .dropdown-item.hoverable
                            span.text-caption-bold Иркутск
                        .dropdown-item.hoverable
                            span.text-caption-bold Севастополь
                        .dropdown-item.hoverable
                            span.text-caption-bold Екатеринбург
                        .dropdown-item.hoverable
                            span.text-caption-bold Казань
                        .dropdown-item.hoverable
                            span.text-caption-bold Ростов-на-Дону
                        .dropdown-item.hoverable
                            span.text-caption-bold Владивосток
                p.text-caption-bold.color-black +7 495 987-65-43
                p
                    span.text-caption-bold.color-black Пн–Пт 
                    span.text-caption.color-black с 9:00 до 18:00
                p.text-caption.color-black Адрес: Переведеновский пер., 13, стр.. 16, оф.. 216, Москва, Россия, 105082
                iframe.position-relative.z-3.mt-14.br-20.baw(src="https://yandex.ru/map-widget/v1/?um=constructor%3Aexample_code&source=constructor" height="185")
        .d-flex.d-xl-none.flex-column.w-100.gap-32
            .search-mobile
                img.search-button(src="img/assets/icons/small/icon_search_grey.svg")
                input.search-mobile-input(placeholder="Поиск")
                img.search-close.mobile.br-100.bg-color-light-grey(src="img/assets/icons/small/icon_exit_grey.svg")
            //.menu-item CAN BE .active
            .menu-header.mobile(id="menu-container").active
            .search-result-mobile.br-20.bg-color-white
                .search-value.d-flex.flex-column.px-60.pb-16
