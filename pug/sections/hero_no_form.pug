.container.dev-title
    h2.title-primary.title-section-name_dev(style="font-size: 60px;padding-top: 200px !important") <span>HERO (Без формы) СЕКЦИЯ</span>

section.section.position-relative.overflow-hidden.w-100.vh-100
    img.object-fit-cover.w-100.h-100(src="img/sections/hero_no_form/bg_hero_no_form.jpg" style="filter: brightness(50%)")
    .position-absolute.w-100.h-100.top-0
        //HERO TITLE AND VISIR
        .hero-no-form-title.position-absolute.d-flex.flex-column.justify-content-end.gap-16.gap-md-32.p-24.p-md-32.p-xl-56
            h1.h-3.h-md-2.h-xl-1.color-white
                span.color-white Обучение в Ecostandard group Требования охраны труда 
                span.gradient-academy 2464
            .d-flex.d-lg-none.align-items-center.me-auto.p-8.mb-md-24.gap-8.br-100.bg-color-white-20.bg-blur-50
                img.hero-main-info-icon(src="img/assets/icons/medium/icon_circle_info_white.svg")
                p.text-label.color-white С подробной тарифной системой вы можете ознакомиться на нашем сайте
            img.hero-main-visir(
                src="img/assets/others/hero_visir.svg",
                alt="alt"
            )
        //HERO DESKTOP INPUTS
        .hero-no-form-input.position-absolute.flex-column.p-24.p-md-32.p-xxl-64.gap-16.gap-xxl-32.d-none.d-lg-flex
            p.text-body-bold.h-xl-4.color-white получите документы с учетом новых правил по индивидуальной программе c практическими занятиями:
            .d-flex.flex-column
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Программы А,Б,В
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white СИЗ
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Первая помощь
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Работы на высоте
            .d-flex.flex-column.flex-lg-row.gap-8
                a.btn-academy
                    span.text-center Выбрать программу
                a.btn-outline
                    span.text-center Электронные курсы
        //HERO INFO WARNING
        .hero-no-form-info.position-absolute.flex-column.p-24.p-md-32.p-xl-56.gap-32.d-none.d-lg-flex
            .d-flex.align-items-center.me-auto.p-8.gap-8.br-100.bg-color-white-20
                img.hero-main-info-icon(src="img/assets/icons/medium/icon_circle_info_white.svg")
                p.text-label.me-0.me-md-30.me-xl-0.color-white С подробной тарифной системой вы можете ознакомиться на нашем сайте
        //HERO MOBILE INPUTS
        .hero-no-form-input.position-absolute.flex-column.p-24.p-md-32.justify-content-between.d-flex.d-lg-none
            p.text-body-bold.color-white получите документы с учетом новых правил по индивидуальной программе c практическими занятиями:
            .d-flex.flex-column
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Программы А,Б,В
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white СИЗ
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Первая помощь
                .d-flex.gap-8.py-4
                    img.mt-5.mb-auto(src="img/assets/icons/small/icon_visir_academy.svg")
                    p.color-white Работы на высоте
            .d-flex.flex-column.flex-md-row.gap-8
                a.btn-academy
                    span.text-center Выбрать программу
                a.btn-outline
                    span.text-center Электронные курсы
